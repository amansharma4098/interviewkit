{
  "name": "preptrick",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-kits.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src worker tests scripts/*.mjs index.html vite.config.js wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.6.2",
    "playwright": "^1.55.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
