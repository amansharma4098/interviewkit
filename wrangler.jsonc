{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preptrick",
  "account_id": "43d392f1d7c9c09fc2ebef7db6ee8bc5",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preptrick-db",
      "database_id": "2b50ffc9-a7ef-457b-b096-664d7f239306",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "BUSINESS_NAME": "PrepTrick",
    "SUPPORT_EMAIL": "",
    "CHECKOUT_ENABLED": "false",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
